{
  "manifest_version": 3,
  "name": "webllm puente",
  "version": "0.8.0",
  "description": "webllm on this PC: writes to the AI chats you connect, reads the answers, repairs changed pages, records chats you ask it to.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "system.display"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.z.ai/*",
    "https://www.meta.ai/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ],
  "action": {
    "default_title": "webllm",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
