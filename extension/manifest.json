{
  "manifest_version": 3,
  "name": "webllm puente",
  "version": "0.6.0",
  "description": "Lets webllm (on this PC) write to the AI chat sites you connect (Qwen, DeepSeek, z.ai, Meta AI, the ones in webllm's list and any you add) and read the answers.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "notifications",
    "system.display"
  ],
  "host_permissions": [
    "https://chat.qwen.ai/*",
    "https://chat.deepseek.com/*",
    "https://chat.z.ai/*",
    "https://www.meta.ai/*",
    "http://127.0.0.1/*"
  ],
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "optional_host_permissions": [
    "https://*/*"
  ]
}
